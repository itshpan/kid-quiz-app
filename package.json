{
  "name": "learning-lab",
  "private": true,
  "description": "Interactive lessons and quizzes for Grade 6, Term 1",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "check": "node tools/check-content.mjs",
    "preview": "node tools/build-preview.mjs content/science/w1-skeleton.json dist/preview.html",
    "deploy": "npx wrangler@latest pages deploy . --project-name=learning-lab --branch=main --commit-dirty=true",
    "images": "node tools/fetch-images.mjs",
    "db:local": "wrangler d1 execute learning-lab --local --file=db/schema.sql",
    "db:create": "wrangler d1 create learning-lab",
    "db:init": "wrangler d1 execute learning-lab --remote --file=db/schema.sql",
    "db:class": "node tools/new-class.mjs",
    "dev": "wrangler pages dev . --local"
  }
}
